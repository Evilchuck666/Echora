parameters:
    level: max
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Generated by Symfony: array shapes for the config files.
        - config/reference.php
    symfony:
        # Dumped on cache warmup in the dev environment (bin/console cache:warmup).
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
