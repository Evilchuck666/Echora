{
  // PHP runs inside Docker, not on the host: disable the built-in features that need a local php binary.
  "php.validate.enable": false,
  "php.suggest.basic": false,

  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
  },

  // Must match the PHP version of the Docker image (Dockerfile: dunglas/frankenphp:1-php8.5).
  "intelephense.environment.phpVersion": "8.5.0",

  // Intelephense defaults plus Symfony's var/ (cache holds generated copies of classes and would duplicate symbols).
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/CVS/**",
    "**/.DS_Store/**",
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**/{Tests,tests}/**",
    "**/.history/**",
    "**/vendor/**/vendor/**",
    "**/var/**"
  ],

  "files.watcherExclude": {
    "**/var/**": true,
    "**/vendor/**": true
  },
  "search.exclude": {
    "**/var/**": true,
    "**/vendor/**": true
  },
  "python.terminal.useEnvFile": true
}
