{
  // Folder-scoped settings only (resource and language scopes). The project is opened through Echora.code-workspace,
  // and VS Code ignores window-scoped settings in this file when it is: those live in the workspace file. Never repeat
  // a setting in both places.

  // Symfony Language Tools boots the kernel for runtime metadata: run it in the php container (needs the stack up).
  "symfonyLsp.phpCommand": ["docker", "compose", "exec", "-T", "php", "php"],
  "symfonyLsp.containerProjectRoot": "/app",

  // Intelephense's defaults plus Symfony's var/: its cache holds generated copies of classes, which would duplicate
  // symbols. On the host var/ is only the mount point of a Docker volume, unless compose.override.yaml stops mounting it.
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/CVS/**",
    "**/.DS_Store/**",
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**/{Tests,tests}/**",
    "**/.history/**",
    "**/vendor/**/vendor/**",
    "**/var/**"
  ],

  // Composer's vendor/ and Symfony's var/ change thousands of files at once (composer install, cache warmup): don't
  // watch them. Search already leaves them out, because it follows .gitignore.
  "files.watcherExclude": {
    "**/vendor/**": true,
    "**/var/**": true
  }
}
