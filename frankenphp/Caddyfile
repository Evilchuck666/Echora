{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root /app/public
	encode zstd br gzip

	mercure {
		# Share the hub between the addresses listed in SERVER_NAME (e.g. "localhost, php:80")
		name default
		# Trusted issuer: binds the iss claim access tokens must carry to its keys.
		# In production, set MERCURE_TRUSTED_ISSUERS to the stable identifier of your token issuer
		# (your app's URL for self-issued tokens).
		issuer {$MERCURE_TRUSTED_ISSUERS:https://localhost} {
			# Publisher JWT key
			publisher {
				jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
			}
			# Subscriber JWT key
			subscriber {
				jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
			}
		}
		# Allow anonymous subscribers (double-check that it's what you want)
		anonymous
		# Enable the subscription API (double-check that it's what you want)
		subscriptions
		# Extra directives
		{$MERCURE_EXTRA_DIRECTIVES}
	}

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Library files (audio, covers) and images in var/media are sent by Caddy, not by PHP: PHP checks the access
	# and answers with an X-Accel-Redirect header (LibraryFiles, Symfony's BinaryFileResponse), then Caddy serves
	# the file, with byte ranges and no time limit. Streamed by PHP, a track read slowly by a player hit
	# max_execution_time after 30 seconds, and held a PHP worker for minutes.
	# Both request headers are always overwritten here: a client must never choose where a path is mapped.
	request_header X-Sendfile-Type x-accel-redirect
	request_header X-Accel-Mapping "/music/=/music/,/app/var/media/=/app/var/media/"

	intercept {
		@sendfile header X-Accel-Redirect *
		handle_response @sendfile {
			root * /
			rewrite * {resp.header.X-Accel-Redirect}
			header -X-Accel-Redirect
			# Defense in depth: only the music library and the media folder, whatever the header says.
			@outside not path /music/* /app/var/media/*
			respond @outside 404
			file_server
		}
	}

	# The web client (Echora Web), built into the production image at /srv/web (Dockerfile: web_build) and served at
	# the root of the site, on the same origin as the API. Development images don't have it: the client runs on Vite.
	@webClient {
		not path /api /api/* /bundles/* /.well-known/* /_profiler* /_wdt* /index.php
		file {
			root /srv/web
			try_files /index.html
		}
	}
	handle @webClient {
		root * /srv/web
		# Built assets have a hash in their name: cache them for good. Everything else is checked on every visit.
		@assets {
			path /assets/*
			file
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		header X-Content-Type-Options nosniff
		header Referrer-Policy same-origin
		# Routes of the app (/artists/..., /search...) are index.html; React Router takes it from there.
		@route {
			not path /assets/*
			not file
		}
		rewrite @route /index.html
		file_server
	}

	handle {
		@phpRoute {
			not path /.well-known/mercure*
			not file {path}
		}
		rewrite @phpRoute index.php

		@frontController path index.php
		php @frontController {
			{$FRANKENPHP_SITE_CONFIG}

			worker {
				file ./public/index.php
				{$FRANKENPHP_WORKER_CONFIG}
			}
		}

		file_server {
			hide *.php
		}
	}
}
