# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
# Fixed, public values: tests protect nothing. Their own JWT key pair (generated by docker-entrypoint), as .env.local,
# where the development passphrase lives, isn't read in the test environment.
APP_SECRET='$ecretf0rt3st'
JWT_SECRET_KEY='%kernel.project_dir%/config/jwt/test/private.pem'
JWT_PUBLIC_KEY='%kernel.project_dir%/config/jwt/test/public.pem'
JWT_PASSPHRASE='test-passphrase'
MUSIC_LIBRARY_PATH='%kernel.project_dir%/tests/Fixtures/music'
# Tests never reach TheAudioDB: the ones about it replace the HTTP client.
THEAUDIODB_API_KEY=
