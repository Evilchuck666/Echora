# Production settings for Docker Compose. Copy this file to prod.env (git-ignored),
# fill in every value, then start Echora with:
#
#   docker compose --env-file prod.env -f compose.yaml -f compose.prod.yaml up --wait

# Folder on this machine that holds your music. Mounted read-only.
MUSIC_DIR=${HOME}/Music

# Domain name the server answers to. Caddy gets a TLS certificate for it automatically.
SERVER_NAME=music.example.com

# The web client is built into the image from this folder (a checkout of https://github.com/Evilchuck666/echora-web)
# and served at https://SERVER_NAME/. Relative to this folder; ../echora-web by default.
#WEB_DIR=../echora-web

# Other sites allowed to call the API from a browser, as a regular expression, e.g. ^https://music\.example\.com$.
# Not needed for the web client above (same origin) nor for native apps: by default no other site may.
#CORS_ALLOW_ORIGIN=

# Seconds during which a spent refresh token still works if its new pair never reached the client (page closed,
# network cut), as long as that pair hasn't been used. 0 turns it off.
#REFRESH_TOKEN_GRACE_SECONDS=300

# Long random secrets, e.g. generated with: openssl rand -hex 32
APP_SECRET=ChangeMe
CADDY_MERCURE_JWT_SECRET=ChangeMe
POSTGRES_PASSWORD=ChangeMe
# Protects the private key that signs the JWTs.
JWT_PASSPHRASE=ChangeMe

# Album covers and artist images missing from their folders are looked up on TheAudioDB (theaudiodb.com) with its
# free key, 123. Set your own key here, or leave it empty to never contact TheAudioDB.
#THEAUDIODB_API_KEY=123
