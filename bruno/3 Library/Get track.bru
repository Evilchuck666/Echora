meta {
  name: Get track
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/tracks/{{trackId}}
  body: none
  auth: inherit
}

tests {
  test("returns the track", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("trackId"));
  });

  test("includes the lyrics when the track has them", function () {
    expect(res.body.hasLyrics).to.be.a("boolean");
    if (res.body.hasLyrics) {
      expect(res.body.lyrics).to.be.a("string");
    }
  });
}

docs {
  The track found by **List tracks**, with its lyrics (lists only say `hasLyrics`). With ReplayGain tags in its file, `replayGain` holds `trackGain`/`albumGain` (dB) and `trackPeak`/`albumPeak` (1.0 = full scale), those the file has; it is left out without any (tracks scanned before need a full scan).
}
