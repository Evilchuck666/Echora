meta {
  name: List tracks
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/tracks
  body: none
  auth: inherit
}

params:query {
  ~album: {{albumIri}}
  ~artist: {{artistIri}}
  ~title: 
  ~genre: 
  ~page: 1
}

script:post-response {
  if (res.status === 200 && res.body.member.length > 0) {
    bru.setVar("trackId", res.body.member[0].id);
    bru.setVar("streamUrl", res.body.member[0].streamUrl);
    // Only FLAC tracks have an Opus version (MP3 ones have no opusStreamUrl).
    const flac = res.body.member.find((track) => track.opusStreamUrl);
    if (flac) {
      bru.setVar("opusTrackId", flac.id);
      bru.setVar("opusStreamUrl", flac.opusStreamUrl);
    }
  }
}

tests {
  test("lists tracks with a signed streamUrl", function () {
    expect(res.status).to.equal(200);
    expect(res.body.member).to.be.an("array").that.is.not.empty;
    expect(res.body.member[0].streamUrl).to.contain("_hash=");
  });

  test("never exposes where files live on the server", function () {
    expect(res.body.member[0]).to.not.have.property("path");
  });
}

docs {
  Tracks sorted by disc and track number. Enable `album` to list the tracks of the album found by **List albums**. Remembers the first track (`trackId`, `streamUrl`) for **Get track** and **4 Media**, and the first FLAC track (`opusTrackId`, `opusStreamUrl`) for the Opus requests.
}
