meta {
  name: List tracks
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/tracks
  body: none
  auth: inherit
}

params:query {
  ~album: {{albumIri}}
  ~artist: {{artistIri}}
  ~albumArtist: {{artistIri}}
  ~title: 
  ~genre: 
  ~page: 1
}

script:post-response {
  if (res.status === 200 && res.body.member.length > 0) {
    bru.setVar("trackId", res.body.member[0].id);
    bru.setVar("streamUrl", res.body.member[0].streamUrl);
    // Only FLAC tracks have an Opus version (MP3 ones have no opusStreamUrl).
    const flac = res.body.member.filter((track) => track.opusStreamUrl);
    if (flac.length > 0) {
      bru.setVar("opusTrackId", flac[0].id);
      bru.setVar("opusStreamUrl", flac[0].opusStreamUrl);
    }
    // A JSON list, written as is into the body of "Convert to Opus ahead of time".
    bru.setVar("opusTrackIds", JSON.stringify(flac.slice(0, 20).map((track) => track.id)));
  }
}

tests {
  test("lists tracks with a signed streamUrl", function () {
    expect(res.status).to.equal(200);
    expect(res.body.member).to.be.an("array").that.is.not.empty;
    expect(res.body.member[0].streamUrl).to.contain("_hash=");
  });

  test("never exposes where files live on the server", function () {
    expect(res.body.member[0]).to.not.have.property("path");
  });
}

docs {
  Tracks in the order of the library: album artists by name, their albums by year and title, then disc and track number. Enable `album` to list the tracks of the album found by **List albums**, or `albumArtist` for every track of the albums of the artist found by **List artists** (`artist` filters by track artist instead, so it also finds their appearances on other artists' albums). Remembers the first track (`trackId`, `streamUrl`) for **Get track** and **4 Media**, the first FLAC track (`opusTrackId`, `opusStreamUrl`) for the Opus requests, and the ids of up to 20 FLAC tracks (`opusTrackIds`) for **Convert to Opus ahead of time**.
}
