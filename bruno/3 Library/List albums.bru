meta {
  name: List albums
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/albums
  body: none
  auth: inherit
}

params:query {
  ~artist: {{artistIri}}
  ~title: 
  ~year: 
  ~page: 1
}

script:post-response {
  if (res.status === 200 && res.body.member.length > 0) {
    bru.setVar("albumIri", res.body.member[0]["@id"]);
  }
}

tests {
  test("lists albums", function () {
    expect(res.status).to.equal(200);
    expect(res.body.member).to.be.an("array");
  });
}

docs {
  Albums sorted by year. Enable `artist` to list the albums of the artist found by **List artists**. Remembers the first album as `albumIri`.
}
