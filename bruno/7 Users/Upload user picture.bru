meta {
  name: Upload user picture
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/users/{{userId}}/avatar
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(fixtures/avatar.png)
}

tests {
  test("sets the picture of the account", function () {
    expect(res.status).to.equal(200);
    expect(res.body.avatarUrl).to.contain("_hash=");
  });
}
