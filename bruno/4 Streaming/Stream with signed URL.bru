meta {
  name: Stream with signed URL
  type: http
  seq: 2
}

get {
  url: {{streamUrl}}
  body: none
  auth: none
}

headers {
  Range: bytes=0-1023
}

tests {
  test("plays without an Authorization header", function () {
    expect(res.status).to.equal(206);
    expect(res.headers["content-type"]).to.match(/^audio\//);
  });
}

docs {
  Calls the signed `streamUrl` of the track found by **List tracks**, without any authentication, the way an `<audio>` element or a media player would. It expires after six hours: run **List tracks** again for a fresh one.
}
