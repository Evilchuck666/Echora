meta {
  name: Update my account
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/me
  body: json
  auth: inherit
}

headers {
  Content-Type: application/merge-patch+json
  Accept: application/json
}

body:json {
  {
    "name": "Bruno Listener"
  }
}

tests {
  test("changes the name", function () {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("Bruno Listener");
  });
}

docs {
  Changes any of `name`, `username` and `email` of the signed-in account (422 if the username or email is taken or invalid). Sessions stay open: they name the account by its id. Needs `Content-Type: application/merge-patch+json`.
}
