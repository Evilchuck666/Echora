meta {
  name: Change my password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/me/password
  body: json
  auth: inherit
}

body:json {
  {
    "currentPassword": "{{process.env.ECHORA_PASSWORD}}",
    "newPassword": "{{process.env.ECHORA_PASSWORD}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.token);
    bru.setVar("refreshToken", res.body.refresh_token);
    bru.setVar("tokenExpiresAt", Date.now() + 55 * 60 * 1000);
  }
}

tests {
  test("changes the password and returns a new session", function () {
    expect(res.status).to.equal(200);
    expect(res.body.refresh_token).to.be.a("string");
  });
}

docs {
  Sets the password again to the one of `bruno/.env` (change `newPassword` to really change it). Signs the account out of every device and returns a new token pair, as **Sign in**. A wrong `currentPassword` is a 422.
}
