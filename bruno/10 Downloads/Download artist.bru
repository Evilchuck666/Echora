meta {
  name: Download artist
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}{{artistIri}}/download?format=opus
  body: none
  auth: inherit
}

params:query {
  format: opus
}

tests {
  test("lists the artist's tracks", function () {
    expect(res.status).to.equal(200);
    expect(res.body.kind).to.equal("artist");
  });
}

docs {
  The manifest of the artist found by **List artists**, in Opus: their own albums, and their tracks on other artists' albums. MP3 tracks come as they are (`format` says what each file is).
}
