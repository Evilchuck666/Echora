meta {
  name: Move playlist item
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/playlist_items/{{playlistItemId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/merge-patch+json
}

body:json {
  {
    "position": 0
  }
}

tests {
  test("moves the item to the top", function () {
    expect(res.status).to.equal(200);
    expect(res.body.position).to.equal(0);
  });
}

docs {
  Moves the item remembered by **List playlist items** to the top; the items in between shift by one. A position beyond the last item moves it to the end; a negative one is a 422. Needs `Content-Type: application/merge-patch+json` (415 otherwise).
}
