auth {
  mode: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  // Signs in when this request has no valid JWT yet. Needed by the VS Code extension:
  // each request tab keeps its own variables there, so the token stored by "Sign in"
  // in one tab is not visible from the others. Elsewhere it simply renews an expired token.
  //
  // Sign in, Refresh and the signed streamUrl don't send the JWT. They are told apart by
  // URL, not with req.getAuthMode(): the VS Code extension adds the Authorization header
  // after this script runs, so getAuthMode() always answers "none" there. The URL can
  // still hold unresolved variables at this point ("{{baseUrl}}/api/auth", "{{streamUrl}}").
  const url = req.getUrl();
  const sendsToken = !/\/api\/(auth|token\/refresh)\b/.test(url) && !url.includes("streamUrl") && !url.includes("_hash=");
  const expiresAt = Number(bru.getVar("tokenExpiresAt") || 0);

  if (sendsToken && (!bru.getVar("token") || Date.now() >= expiresAt)) {
    const response = await bru.sendRequest({
      method: "POST",
      url: bru.interpolate("{{baseUrl}}/api/auth"),
      headers: { "Content-Type": "application/json" },
      data: {
        username: bru.getProcessEnv("ECHORA_USERNAME"),
        password: bru.getProcessEnv("ECHORA_PASSWORD"),
      },
    });

    bru.setVar("token", response.data.token);
    bru.setVar("refreshToken", response.data.refresh_token);
    // The JWT lasts one hour: renew it a little earlier.
    bru.setVar("tokenExpiresAt", Date.now() + 55 * 60 * 1000);
  }
}

docs {
  # Echora API

  1. Copy `bruno/.env.example` to `bruno/.env` and set your username and password.
  2. Select the **Local** environment.
  3. Send any request: the collection signs in on its own when it has no valid JWT (see the collection script). **1 Auth / Sign in** and **1 Auth / Refresh** are there to try those endpoints.

  **3 Library / List tracks** remembers the first track it returns (`trackId`, `streamUrl`) for the requests that come after it. In the VS Code extension, variables don't travel between request tabs: run the collection with the Runner to chain them.

  Bruno must trust the certificate of `https://localhost`: see the README of the repository.
}
