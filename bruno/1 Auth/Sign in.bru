meta {
  name: Sign in
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth
  body: json
  auth: none
}

body:json {
  {
    "username": "{{process.env.ECHORA_USERNAME}}",
    "password": "{{process.env.ECHORA_PASSWORD}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.token);
    bru.setVar("refreshToken", res.body.refresh_token);
    bru.setVar("tokenExpiresAt", Date.now() + 55 * 60 * 1000);
  }
}

tests {
  test("signs in", function () {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string");
    expect(res.body.refresh_token).to.be.a("string");
  });
}

docs {
  Signs in with ECHORA_USERNAME (the username or the email) and ECHORA_PASSWORD from `bruno/.env`, and stores the JWT (`token`) and the refresh token (`refreshToken`) for the other requests.

  After 5 failed attempts for an account from one address (25 from one address, whatever the accounts) in 15 minutes, sign-ins are refused for a while: 429, with a `Retry-After` header in seconds, even with the right password.
}
